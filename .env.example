# === App ===
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text
LATENCY_WARN_MS=1000
API_HOST=0.0.0.0
API_PORT=8000
MODEL_VERSION=0.1.0

# === ML Training ===
RANDOM_SEED=42
TEST_SIZE=0.2
VALIDATION_SIZE=0.2
RECOMMENDATION_K=10

# === SVD ===
SVD_N_FACTORS=50

# === MLP ===
MLP_EMBEDDING_DIM=64
MLP_HIDDEN_DIMS=[128,64]
MLP_EPOCHS=50
MLP_LEARNING_RATE=0.001
MLP_BATCH_SIZE=256

# === MLflow ===
# MLFLOW_TRACKING_URI=databricks -> usa o workspace do time (exige DATABRICKS_HOST/TOKEN
#   abaixo). Só quem está no time FIAP MLE tem essas credenciais.
# MLFLOW_TRACKING_URI=local      -> MLflow local (arquivo em logs/mlruns), sem nenhuma
#   credencial. É o modo usado para rodar o projeto (treinar, promover modelo, subir a
#   API) de ponta a ponta sem acesso ao Databricks. Ver README, seção "Execução do
#   projeto".
MLFLOW_TRACKING_URI=local
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=__set_me__
MLFLOW_EXPERIMENT_NAME=/Shared/mlflow_ecomm_recsys/02 - ECOMM_RECSYS - Production

# === DVC remote (S3 exemplo) ===
DVC_REMOTE_URL=s3://<bucket>/tc2/dvc
AWS_ACCESS_KEY_ID=__set_me__
AWS_SECRET_ACCESS_KEY=__set_me__
AWS_DEFAULT_REGION=us-east-1
